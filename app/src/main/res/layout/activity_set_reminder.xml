<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".activity.SetReminderActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <!-- Toolbar with elevation -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:title="Add Reminder"
            app:titleTextColor="@color/vivid_sky_blue"
            app:navigationIconTint="@color/vivid_sky_blue"
            app:titleCentered="true"
            app:navigationIcon="@drawable/baseline_arrow_back_ios_24" />

        <!-- Main Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <!-- Reminder Input Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_16sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reminder"
                        android:textSize="@dimen/_16sdp"
                        android:textStyle="bold"
                        android:textColor="@color/vivid_sky_blue"
                        android:alpha="0.8" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Your Reminder"
                        android:paddingVertical="@dimen/_12sdp"
                        android:paddingHorizontal="0dp"
                        android:textSize="@dimen/_14sdp"
                        android:textColor="#212121"
                        android:textColorHint="@color/hintcolor"
                        android:background="@android:color/transparent"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:maxLines="4"
                        android:gravity="top"
                        android:layout_marginTop="@dimen/_8sdp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardBackgroundColor="@color/white">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <!-- Date & Time Section -->
                    <TextView
                        android:id="@+id/textDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date and Time"
                        android:textSize="@dimen/_16sdp"
                        android:textStyle="bold"
                        android:textColor="@color/vivid_sky_blue"
                        android:alpha="0.8"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:layout_marginStart="@dimen/_16sdp" />
                    <LinearLayout
                        android:id="@+id/dateTimePickerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="@dimen/_16sdp"
                        android:paddingHorizontal="@dimen/_8sdp">

                        <!-- Day Picker -->
                        <com.shawnlin.numberpicker.NumberPicker
                            android:id="@+id/dayPicker"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/_120sdp"
                            app:np_dividerColor="@android:color/transparent"
                            app:np_selectedTextColor="@color/vivid_sky_blue"
                            app:np_textColor="@color/hintcolor"
                            app:np_selectedTextSize="@dimen/_16sdp"
                            app:np_textSize="@dimen/_12sdp"
                            app:np_wrapSelectorWheel="true"
                            app:np_selectedTypeface="font/poppins_bold.ttf"
                            app:np_typeface="font/poppins_regular.ttf" />

                        <!-- Divider -->
                        <View
                            android:layout_width="@dimen/_1sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:background="#E0E0E0"
                            android:layout_marginHorizontal="@dimen/_4sdp" />

                        <!-- Month Picker -->
                        <com.shawnlin.numberpicker.NumberPicker
                            android:id="@+id/monthPicker"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/_120sdp"
                            app:np_dividerColor="@android:color/transparent"
                            app:np_selectedTextColor="@color/vivid_sky_blue"
                            app:np_textColor="@color/hintcolor"
                            app:np_selectedTextSize="@dimen/_16sdp"
                            app:np_textSize="@dimen/_12sdp"
                            app:np_wrapSelectorWheel="true" />

                        <!-- Divider -->
                        <View
                            android:layout_width="@dimen/_1sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:background="#E0E0E0"
                            android:layout_marginHorizontal="@dimen/_4sdp" />

                        <!-- Hour Picker -->
                        <com.shawnlin.numberpicker.NumberPicker
                            android:id="@+id/hourPicker"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/_120sdp"
                            app:np_dividerColor="@android:color/transparent"
                            app:np_selectedTextColor="@color/vivid_sky_blue"
                            app:np_textColor="@color/hintcolor"
                            app:np_selectedTextSize="@dimen/_16sdp"
                            app:np_textSize="@dimen/_12sdp"
                            app:np_wrapSelectorWheel="true" />

                        <!-- Divider -->
                        <View
                            android:layout_width="@dimen/_1sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:background="#E0E0E0"
                            android:layout_marginHorizontal="@dimen/_4sdp" />

                        <!-- Minute Picker -->
                        <com.shawnlin.numberpicker.NumberPicker
                            android:id="@+id/minutePicker"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/_120sdp"
                            app:np_dividerColor="@android:color/transparent"
                            app:np_selectedTextColor="@color/vivid_sky_blue"
                            app:np_textColor="@color/hintcolor"
                            app:np_selectedTextSize="@dimen/_16sdp"
                            app:np_textSize="@dimen/_12sdp"
                            app:np_wrapSelectorWheel="true" />

                        <!-- Divider -->
                        <View
                            android:layout_width="@dimen/_1sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:background="#E0E0E0"
                            android:layout_marginHorizontal="@dimen/_4sdp" />

                        <!-- AM/PM Picker -->
                        <com.shawnlin.numberpicker.NumberPicker
                            android:id="@+id/amPmPicker"
                            android:layout_width="0dp"
                            android:layout_weight="0.8"
                            android:layout_height="@dimen/_120sdp"
                            app:np_dividerColor="@android:color/transparent"
                            app:np_selectedTextColor="@color/vivid_sky_blue"
                            app:np_textColor="@color/hintcolor"
                            app:np_selectedTextSize="@dimen/_16sdp"
                            app:np_textSize="@dimen/_12sdp"
                            app:np_wrapSelectorWheel="true" />
                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Language Section (Hidden by default) -->
            <TextView
                android:id="@+id/textReminderLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Language"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:textColor="@color/vivid_sky_blue"
                android:letterSpacing="0.05"
                android:alpha="0.8"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_4sdp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/llsetLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardBackgroundColor="@color/white">

                <Spinner
                    android:id="@+id/LangSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_14sdp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Done Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:text="@string/done"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:backgroundTint="@color/vivid_sky_blue"
                android:layout_marginTop="@dimen/_32sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:elevation="4dp"
                app:cornerRadius="@dimen/_12sdp"
                app:rippleColor="#80FFFFFF" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/pgBar"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:indeterminateTint="@color/vivid_sky_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="8dp"
            android:visibility="gone" />

        <!-- Hidden Elements (kept for backward compatibility) -->
        <ImageView
            android:id="@+id/cancel_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_30sdp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/texAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cancel_button" />

        <TextView
            android:id="@+id/textReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>